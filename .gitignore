# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Serena (IDE tooling) symbol cache — large binary, never commit
.serena/cache/

# Rendered email previews (npx vite-node scripts/preview-emails.ts)
.email-preview/

# Eval run output (npm run eval:articles / disputed:pilot / disputed:edit). Run artifacts stay
# local; only the files cited by the spec, a script's usage text, or a run log stay tracked.
scripts/eval-runs/*
!scripts/eval-runs/2026-09-02-live-matrix.json
!scripts/eval-runs/disputed/
scripts/eval-runs/disputed/*
!scripts/eval-runs/disputed/ffl-2025-w8.league-20260903-1714.json
!scripts/eval-runs/samples-*/
scripts/eval-runs/samples-*/*
!scripts/eval-runs/samples-*/README.md
